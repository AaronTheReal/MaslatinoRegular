# Cabeceras de cache del navegador.
#
# Sin este archivo Netlify sirve todo lo estatico con
# "max-age=0, must-revalidate": cada carga de pagina revalidaba los ~7 bundles
# y cada imagen. En el plan por creditos las peticiones se pagan (2 creditos
# por 10.000), asi que eran miles de peticiones al mes que no hacian falta.

# Bundles de Angular: el build los publica con hash de contenido
# (outputHashing: "all"), asi que un cambio siempre estrena nombre de archivo.
# Son inmutables por construccion y se pueden cachear un año sin riesgo.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Imagenes, iconos y fuentes de public/: NO llevan hash, asi que se reemplazan
# con el mismo nombre. Una semana fresco y un mes sirviendo el anterior
# mientras se refresca: si se cambia un icono, tarda en propagarse, pero no
# hay que esperar un año.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
# Las fuentes viven en /fonts/, no en /assets/: hasta el 04/10/2026 no las
# cubria ninguna regla y cada visita volvia a preguntar por ellas.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# robots.txt lo relee Google a menudo; una hora basta. Los sitemaps ya no
# son archivos: los genera server.ts y llevan su propia cache.
/robots.txt
  Cache-Control: public, max-age=3600
