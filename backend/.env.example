PORT=3000
DB_URL=
MONGODB_URI=
JWT_SECRET=

# Sitio público primario para canonical y sitemaps.
PUBLIC_SITE_ORIGIN=https://maslatino.com
PRERENDER_TOKEN=

# Usa una sola de estas dos opciones; nunca subas el JSON al repositorio.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# SEO con IA. El mock es local; el proveedor real aún permanece desactivado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
SEO_AI_MOCK=false

# Medios
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CDN_BASE_URL=
MAX_UPLOAD_MB=10
UPLOAD_PREFIX=uploads
