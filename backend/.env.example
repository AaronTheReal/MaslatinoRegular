PORT=3000
DB_URL=
MONGODB_URI=
JWT_SECRET=

# Sitio público primario para canonical y sitemaps.
PUBLIC_SITE_ORIGIN=https://maslatino.com
PRERENDER_TOKEN=

# Usa una sola de estas dos opciones; nunca subas el JSON al repositorio.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# SEO con IA (proveedor real: Anthropic).
# Con ANTHROPIC_API_KEY definida el asistente queda en modo "live".
# SEO_AI_MOCK=true tiene prioridad y fuerza la simulación local sin gastar tokens.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SEO_AI_MOCK=false

# Ajustes opcionales del proveedor (valores por defecto entre paréntesis).
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_TIMEOUT_MS=60000
ANTHROPIC_MAX_RETRIES=1
# Reutiliza el análisis del mismo borrador durante este tiempo para que un doble
# clic no genere un segundo cargo (300000 ms).
SEO_AI_IDEMPOTENCY_TTL_MS=300000
# Reintento automático en otro modelo si el clasificador declina la petición.
SEO_AI_FALLBACK=true
# Solo para estimar costo en la telemetría; no afecta la facturación real.
ANTHROPIC_INPUT_PRICE_PER_MTOK=5
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=25

# Medios
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CDN_BASE_URL=
MAX_UPLOAD_MB=10
UPLOAD_PREFIX=uploads
